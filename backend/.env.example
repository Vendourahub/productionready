# ==============================================================================
# ProductionReady Backend Environment Configuration
# ==============================================================================

# Database URL
# Default uses local SQLite file. For production, supply a PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/productionready
DATABASE_URL=sqlite:///./productionready.db

# GitHub App Integration (Optional for local testing, required for webhook intake)
# Minimum permissions required: Contents: Read, Metadata: Read, Checks: Write
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=

# Allowed CORS Origins (comma-separated or list in app/config.py)
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
